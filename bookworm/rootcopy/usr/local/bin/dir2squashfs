#!/bin/bash

if [ "$1" = "-runterm" ]; then shift
	if which run-in-terminal > /dev/null; then
		export WNAME=mksquashfs
		exec run-in-terminal ${0} -termrun "$@"
	elif which xterm > /dev/null; then
		exec xterm -T mksquashfs -e ${0} -termrun "$@"
	else
		exec x-terminal-emulator -T mksquashfs -e ${0} -termrun "$@"
	fi
elif [ "$1" = "-termrun" ]; then GUI=1; shift
fi

if [ "`whoami`" != "root" ]; then
	ALLROOT="-all-root"
fi

grep -sq ^MKSFSCMP= /root/*.conf && \
MKSFSCMP=`grep ^MKSFSCMP= /root/*.conf | head -1 | cut -d= -f2 | sed s/\"//g`

if [ -d "$1" ]; then
	DIR="${1%/}" # strip trailing slash from dir name (if it exists)
	shift
	echo "mksquashfs $DIR $DIR.squashfs $ALLROOT -b 1M $MKSFSCMP $@"
	mksquashfs "$DIR" "$DIR".squashfs $ALLROOT -b 1M $MKSFSCMP $@
else
	echo "Exit: No such directory "$1""
fi

[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
