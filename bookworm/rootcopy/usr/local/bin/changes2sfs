#!/bin/bash

# changes2sfs script for creating module from changes
# by gumanzoy https://github.com/PocketHandyBox

# Use code from 'remastercow' by fredx181
# https://github.com/doglinux/bookworm/raw/master/amd64/remaster-scripts_1.0.9_all.deb

# Renamed from remastercow to changes2sfs
# Added . /usr/local/lib/cleanup
# Re-write, support CLI mode, support non-root user by pkexec

YADTITLE="Changes2sfs (create module from changes)"

info_dpkg_reg() {
INFODPKGREG="Question 1: What happens if I leave the default Disable dpkg registration box checked?
Answer 1: The information for the packages included in this module will stay hidden for the system but the module will work any time you decide to load it. It will be safe also to load it on different debian system. The only disadvantage is some dependencies in this module needed for later created modules will be downloaded again and included also in the other module, but this will make possible for every module to work without the need of dependency included in another module. It is recommended to leave it this way.

Question 2: What happens if I uncheck Disable dpkg registration box?
Answer 2: Dpkg registration information from this module will overwrite the information in the main module. It is not a problem if you load this module every time on boot. You need to be sure it is the last module loaded from the system on boot by naming with higher number (02, 03, 04-my-changes.squashfs for example) and it is best to place it inside /live folder. But if you are going to load the module from time to time and like to share it with others safely, do not uncheck the box.

More general information what Disable dpkg registration do:
It simply renames '/var/lib/dpkg/info', '/var/lib/dpkg/status', '/var/lib/dpkg/available' adding 'new' at the end."

echo "$INFODPKGREG" | yad --title='Info dpkg registration' --window-icon=tap-create \
 --width=600 --height=400 --text-info --wrap --button=Close\!gtk-close
}
export -f info_dpkg_reg

show_gui() {
MNTPT="`findmnt -k -n --raw --real --uniq -o TARGET,FSTYPE,OPTIONS | grep ' rw,' | cut -d' ' -f1,2 | egrep -v 'fuse|fat$' | cut -d' ' -f1`"
MNTPT="`echo $MNTPT | sed 's/ /!/g'`"

TEXT="Create a module from the changes you made to the system.\n
<u>Note: Manually loaded squashfs modules will be deactivated.</u>\n
Choose where to create new module, must be on linux filesystem, NTFS or FAT filesytems are excluded.\n
For no dpkg registration check the box 'Disable dpkg registration'"

SETUP="`yad --title="$YADTITLE" --window-icon=tap-create --text="$TEXT" --form --width=450 \
 --field="*** Click for info about dpkg registration ***:BTN" "bash -c info_dpkg_reg" \
 --field="Choose where to create new module::CB" "/tmp!$MNTPT" \
 --field="Type custom name of working directory:" "${RANDOM:0:2}-module" \
 --field="Disable dpkg registration:CHK" "TRUE" \
 --field="Remove working directory:CHK" "TRUE" \
 --button=Quit\!gtk-quit:1 --button=OK\!gtk-ok:0`"
[ $? -eq 0 ] || exit 0

MNTPT="`echo $SETUP | cut -d "|" -f 2`"
DIR="`echo $SETUP | cut -d "|" -f 3`"
NOPKG="`echo $SETUP | cut -d "|" -f 4`"
RMDIR="`echo $SETUP | cut -d "|" -f 5`"

[ -z "$DIR" ] && DIR=module
WORK="$MNTPT"/"$DIR"

[ "$NOPKG" = "TRUE" ] && OPTIONS="-nopkg"
[ "$RMDIR" = "TRUE" ] && OPTIONS="$OPTIONS -rmdir"

if [ "$RMDIR" != "TRUE" ] && [ -d "$WORK" ]; then
yad --title="$YADTITLE" --window-icon=tap-create --image=dialog-warning --center --fixed --button=Close\!gtk-close \
 --text="Directory '$WORK' already exists,\nPlease rename and run again."
exit 0
fi

if [ -f "$WORK".squashfs ]; then
yad --title="$YADTITLE" --window-icon=tap-create --image=dialog-warning --center --fixed --button=Close\!gtk-close \
 --text="Module '$WORK.squashfs' already exists,\nPlease rename and run again."
exit 0
fi

if [ -d /mnt/live/memory/images ]; then # porteus-boot
	MNTSFS=/mnt/live/memory/images/SFS
else # live-boot
	MNTSFS=/mnt/SFS
fi

if [ "$(ls $MNTSFS 2> /dev/null)" ]; then
yad --title="$YADTITLE" --window-icon=tap-create --image=dialog-question --center --fixed \
 --text="Required is to unload modules that were manually loaded,\notherwise your module will include broken symlinks.\n\nContinue ?"
[ $? -ne 0 ] && exit 1
fi

if [ "`whoami`" != "root" ] && which pkexec > /dev/null; then
	PKEXEC=pkexec
fi

if which run-in-terminal > /dev/null; then
	export WNAME=changes2sfs
	run-in-terminal ${PKEXEC} ${0} "$WORK" -runterm $OPTIONS
elif which xterm > /dev/null; then
	xterm -T changes2sfs -e ${PKEXEC} ${0} "$WORK" -runterm $OPTIONS
else
	x-terminal-emulator -T changes2sfs -e ${PKEXEC} ${0} "$WORK" -runterm $OPTIONS
fi

exit 0
}

[ "$1" = "-gui" ] && show_gui

echo -e "# changes2sfs script for creating module from changes\n"

until [ "$#" -eq 0 ]; do case "$1" in
-runterm) GUI=1; PAUSE=1; shift ;;
-pause) PAUSE=1; shift ;;
-nopkg) NOPKG=1; shift ;;
-rmdir) RMDIR=1; shift ;;
*) WORKDIR="`dirname "$1" 2> /dev/null`"
WORKDIR="`realpath -e "$WORKDIR" 2> /dev/null`"
[ -d "$WORKDIR" ] && WORK="$WORKDIR"/"`basename "$1"`"
shift ;;
esac; done

if [ -z "$WORK" ] || [ "`dirname "$WORK" 2> /dev/null`" = "/" ]; then
	echo "Usage:"
	echo "changes2sfs -gui Show YAD GUI"
	echo "changes2sfs WORKDIR [options]"
	echo -e "\nWORKDIR - Temporary directory to copy module files, e.g."
	echo "changes2sfs /tmp/${RANDOM:0:2}-module"
	echo -e "\nOptions:"
	echo " -pause Pause before run mksquashfs"
	echo " -nopkg Disable dpkg registration"
	echo " -rmdir Remove working directory"
	exit
fi

if [ "`whoami`" != "root" ]; then
	[ -z "`which pkexec`" ] && echo "pkexec is not installed"
	echo "This script should be run as root"
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

sfsunload

if [ -d /mnt/live/memory/changes/upperdir ]; then # porteus-boot
	CHANGES=/mnt/live/memory/changes/upperdir
elif [ -d /mnt/live/memory/changes/filesystem ]; then # pfull=
	CHANGES=/mnt/live/memory/changes/filesystem
else # live-boot
	CHANGES=/live/cow
fi

if [ -z "$(ls $CHANGES 2> /dev/null)" ]; then
	echo -e "Changes directory is empty $CHANGES\nSomething went wrong. Exit."
	exit 1
fi

[ "$RMDIR" ] && rm -rf "$WORK"

if [ -d "$WORK" ]; then
	echo -e "Directory '$WORK' already exists,\nPlease rename and run again."
	exit 1
fi

if [ -f "$WORK".squashfs ]; then
	echo -e "Module '$WORK.squashfs' already exists,\nPlease rename and run again."
	exit 1
fi

dpkg --purge `dpkg --get-selections | grep deinstall | cut -f1` 2> /dev/null

CHNUSED=$(du -cs --apparent-size "$CHANGES" | tail -1 | cut -f1)
CHNUSEDMB=$(du -chs --apparent-size "$CHANGES" | tail -1 | cut -f1)
DIRFREE=$(df -k --output=avail "$WORKDIR" | tail -1 | tr -d ' ')
DIRFREEMB=$(df -m --output=avail "$WORKDIR" | tail -1 | tr -d ' ')

echo "Changes data to copy: $CHNUSEDMB / available free space: ${DIRFREEMB}MB"

if [ "$DIRFREE" -lt "$CHNUSED" ]; then
	echo -e "Not enough free space available in $WORKDIR\n"
	[ $GUI ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

mkdir -p "$WORK" # Make new directory

rsync -a --info=progress2 --exclude={'dev/','media/','mnt/','run/','tmp/','var/cache/apt/','var/lib/apt/lists/'} "$CHANGES"/ "$WORK"/ 2> /dev/null

echo -e "\nCleaning..."

if [ "$NOPKG" ]; then
	mv "$WORK"/var/lib/dpkg/info "$WORK"/var/lib/dpkg/infonew 2> /dev/null
	mv "$WORK"/var/lib/dpkg/status "$WORK"/var/lib/dpkg/statusnew 2> /dev/null
	mv "$WORK"/var/lib/dpkg/available "$WORK"/var/lib/dpkg/availablenew 2> /dev/null
fi

. /usr/local/lib/cleanup

cd "$WORK" && cleanup 2> /dev/null
cd ..

if [ "$GUI" ]; then
	echo -e "\n\e[36mNow you may want to review files in:\e[1;33m ${WORK}"
	echo -e "\e[0;36mAnd do some extra cleaning before creating module\e[0m\n"
fi

[ "$PAUSE" ] && read -s -n 1 -p "Press any key to run mksquashfs"

grep -sq ^MKSFSCMP= /root/*.conf && \
MKSFSCMP=`grep ^MKSFSCMP= /root/*.conf | head -1 | cut -d= -f2 | sed s/\"//g`

mksquashfs "$WORK" "$WORK".squashfs -b 1M $MKSFSCMP
ret=$?

[ "$RMDIR" ] && rm -rf "$WORK"

if [ $ret -eq 0 ]; then
	echo -e "\n\e[1mModule created: \e[33m${WORK}.squashfs\e[0m"
else
	echo -en "\nFAILED. "
fi

[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."

exit $ret
