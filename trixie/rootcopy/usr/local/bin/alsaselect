#!/bin/dash

# alsaselect Choose default sound card
# by gumanzoy https://github.com/PocketHandyBox

# Renamed from Multiple-Sound-Card-Wizard to alsaselect
# Deprecated gtkdialog-splash replaced by yad
# Add speaker-test
# Can run under non-root user
# Unmute HDMI

DEVICES="`aplay -l | grep card | grep -v pcspeaker`"
if [ "$DEVICES" = "" ]; then
yad --title=alsaselect --text="No Sound Devices Detected" --window-icon=audio-card --center --fixed --button=Close\!gtk-close
exit
fi

if [ "`whoami`" = "root" ] && [ -f /root/.asoundrc ]; then ASOUNDCONF=/root/.asoundrc
elif [ "`whoami`" = "root" ]; then ASOUNDCONF=/etc/asound.conf
elif [ -f /etc/asound.conf ]; then ASOUNDCONF=~/.asoundrc
cp /etc/asound.conf ~/.asoundrc
else ASOUNDCONF=~/.asoundrc
fi

unmute_hdmi() {
LANG=C amixer scontrols 2>/dev/null | sed s/'Simple mixer control '//g | grep -v PCM | while read CONTROL; do
amixer sset "$CONTROL" unmute 2>/dev/null
done
}

ACARD="`grep -m1 defaults.pcm.card "$ASOUNDCONF" 2>/dev/null | rev | cut -d' ' -f1 | rev`"
ADEVICE="`grep -m1 defaults.pcm.device "$ASOUNDCONF" 2>/dev/null | rev | cut -d' ' -f1 | rev`"
ACTIVE="`aplay -l | grep card | grep -w "card $ACARD" | grep -w "device $ADEVICE" | cut -f1,2 -d'[' | sed 's/[ ]$//'`"
[ -z "$ACTIVE" ] && ACTIVE="`aplay -l | grep card | grep -m1 -w "card $ACARD" | cut -f1,2 -d'[' | sed 's/[ ]$//'`"
[ -z "$ACTIVE" ] && ACTIVE="`aplay -l | grep -m1 card | cut -f1,2 -d'[' | sed 's/[ ]$//'`"

aplay_list_devices() {
aplay -l | grep card | cut -f1,2 -d'[' | while read LINE; do
[ "$LINE" = "$ACTIVE" ] && echo TRUE || echo FALSE
echo "$LINE"
done
}

while true; do
ACTIVE="`aplay_list_devices | yad --title=alsaselect --image=audio-speakers --window-icon=audio-card \
 --text="<b>alsaselect</b> Choose default sound card\nSelect card and press 'OK', then listen to the speakers" \
 --width=600 --height=300 --fixed --center --list --radiolist --listen --no-click --no-selection \
 --expand-column=2 --print-column=2 --column=# --column=Card --button=Quit\!gtk-quit:1 --button=OK\!gtk-ok:0`"
[ "$?" = 1 -o "$?" = 252 ] && break

ACTIVE="`echo "$ACTIVE" | cut -d'|' -f1`"
CARD="`echo "$ACTIVE" | cut -d':' -f1 | rev | cut -d' ' -f1 | rev`"
DEVICE="`echo "$ACTIVE" | cut -d':' -f2 | rev | cut -d' ' -f1 | rev`"

echo "defaults.pcm.card $CARD" > "$ASOUNDCONF"
echo "defaults.pcm.device $DEVICE" >> "$ASOUNDCONF"
echo "defaults.ctl.card $CARD" >> "$ASOUNDCONF"

echo "$ACTIVE" | grep -q HDMI && unmute_hdmi >/dev/null

speaker-test -c 2 -t wav -l 2 >/dev/null 2>&1 &

yad --title=alsaselect --image=audio-speakers --text=speaker-test --window-icon=audio-card --timeout=4 \
 --timeout-indicator top --width=200 --borders=10 --sticky --fixed --center --on-top --skip-taskbar --no-buttons
done
