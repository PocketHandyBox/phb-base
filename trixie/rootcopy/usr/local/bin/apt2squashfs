#!/bin/bash

# apt2squashfs script for creating module from package(s)
# by gumanzoy https://github.com/PocketHandyBox

# Use code from 'apt2sfs' by fredx181
# https://github.com/doglinux/bookworm/raw/master/amd64/apt2sfs_1.1.4_all.deb

# Renamed from apt2sfs to apt2squashfs
# Replace unionfs-fuse with overlayfs
# Remove live-boot support
# Add . /usr/local/lib/cleanup
# Add 'Disable dpkg registration' checkbox
# Copy to chroot apt/*pkgcache.bin and apt/lists/* files
# Re-write, support CLI mode, support non-root user by pkexec

YADTITLE="Apt2squashfs (create module from package(s))"

info_dpkg_reg() {
INFODPKGREG="Question 1: What happens if I leave the default Disable dpkg registration box checked?
Answer 1: The information for the packages included in this module will stay hidden for the system but the module will work any time you decide to load it. It will be safe also to load it on different debian system. The only disadvantage is some dependencies in this module needed for later created modules will be downloaded again and included also in the other module, but this will make possible for every module to work without the need of dependency included in another module. It is recommended to leave it this way.

Question 2: What happens if I uncheck Disable dpkg registration box?
Answer 2: Dpkg registration information from this module will overwrite the information in the main module. It is not a problem if you load this module every time on boot. You need to be sure it is the last module loaded from the system on boot by naming with higher number (02, 03, 04-my-changes.squashfs for example) and it is best to place it inside /live folder. But if you are going to load the module from time to time and like to share it with others safely, do not uncheck the box.

More general information what Disable dpkg registration do:
It simply renames '/var/lib/dpkg/info', '/var/lib/dpkg/status', '/var/lib/dpkg/available' adding 'new' at the end."

echo "$INFODPKGREG" | yad --title='Info dpkg registration' --window-icon=tap-create \
 --width=600 --height=400 --text-info --wrap --button=Close\!gtk-close
}
export -f info_dpkg_reg

show_gui() {
MNTPT="`findmnt -k -n --raw --real --uniq -O rw -o TARGET,FSTYPE | egrep -v 'fuse|fat$' | cut -d' ' -f1`"
MNTPT="`echo $MNTPT | sed 's/ /!/g'`"

TEXT="Create module from temporary installed package(s) by apt-get.\n
Depending on the sort of application(s) it may work or not. An application depending on startup at boot might not work. The package(s) will be installed in chroot using 'overlayfs'. This way no traces are left behind in the actual running system.\n
Choose where to create new module, must be linux filesystem, NTFS or FAT filesytems are excluded.\n
For no dpkg registration check the box 'Disable dpkg registration'"

SETUP=`yad --title="$YADTITLE" --window-icon=tap-create --text="$TEXT" --form --width=500 \
 --field="*** Click for info about dpkg registration ***:BTN" "bash -c info_dpkg_reg" \
 --field="Choose where to create new module::CB" "/mnt/live!$MNTPT" \
 --field="Packagename(s) separated by a space:" "" \
 --field="Disable dpkg registration:CHK" "TRUE" \
 --field="Remove working directory:CHK" "TRUE" \
 --button=Quit\!gtk-quit:1 --button=OK\!gtk-ok:0`
[ $? -eq 0 ] || exit 0

MNTPT="`echo $SETUP | cut -d "|" -f 2`"
INSTALL="`echo $SETUP | cut -d "|" -f 3 | tr -s ' '`"
NOPKG="`echo $SETUP | cut -d "|" -f 4`"
RMDIR="`echo $SETUP | cut -d "|" -f 5`"

[ "$NOPKG" = "TRUE" ] && OPTIONS="-nopkg"
[ "$RMDIR" = "TRUE" ] && OPTIONS="$OPTIONS -rmdir"

if [ -z "$INSTALL" ] || [ "$INSTALL" = ' ' ]; then
	INSTALL=""
	return 1
fi

if [ "`whoami`" != "root" ]; then
	if which pkexec > /dev/null; then PKEXEC=pkexec
	elif which sudo > /dev/null; then PKEXEC=sudo
	fi
fi

if which run-in-terminal > /dev/null; then
	export WNAME=apt2squashfs
	exec run-in-terminal ${PKEXEC} ${0} -dir "$MNTPT" -runterm $OPTIONS "$INSTALL"
elif which xterm > /dev/null; then
	exec xterm -T apt2squashfs -e ${PKEXEC} ${0} -dir "$MNTPT" -runterm $OPTIONS "$INSTALL"
else
	exec x-terminal-emulator -T apt2squashfs -e ${PKEXEC} ${0} -dir "$MNTPT" -runterm $OPTIONS "$INSTALL"
fi

exit 0
}

if [ "$1" = "-gui" ]; then
	while [ -z "$INSTALL" ]; do show_gui; done
	exit 0
fi

echo -e "# apt2squashfs script for creating module from package(s)\n"

show_help() {
echo "Usage:"
echo "apt2squashfs -gui Show YAD GUI"
echo "apt2squashfs [-dir WORKDIR] [options] INSTALL"
echo -e "\n -dir WORKDIR - Temporary writeable directory to copy module files
 must be mounted tmpfs or linux filesystem, overlayfs are excluded
 by default /mnt/live is used"
echo -e "\n INSTALL - Packagename(s) separated by a space"
echo -e "\nOptions:"
echo " -pause Pause before run mksquashfs"
echo " -nopkg Disable dpkg registration"
echo " -rmdir Remove working directory"
exit 1
}

find_mnt() {
WORK="`realpath -e "$1" 2> /dev/null`"
[ -z "$WORK" ] && show_help
# Check WORKDIR is on mounted linux filesystem
[ -n "`findmnt -k -n --raw --real --uniq -O rw -o FSTYPE --target "$WORK" | egrep -v 'fuse|fat$'`" ] && return 0
# If fail - check WORKDIR is on tmpfs
findmnt -k -n --raw --pseudo --uniq -O rw -t tmpfs --target "$WORK" 2> /dev/null && return 0
show_help
}

if [ "$1" = "-dir" ]; then shift
	if [ -d "$1" ]; then find_mnt "$1" && shift
	else show_help
	fi
fi

[ -z "$WORK" ] && WORK=/mnt/live

for PARAM in $@
do case "$PARAM" in
-h) show_help ;;
--help) show_help ;;
-runterm) export GUI=1; PAUSE=1; shift ;;
-pause) PAUSE=1; shift ;;
-nopkg) NOPKG=1; shift ;;
-rmdir) export RMDIR=1; shift ;;
esac; done

export INSTALL="`echo "$@" | tr -s ' '`"

[ "$INSTALL" = ' ' ] && INSTALL=""
[ -z "$INSTALL" ] && show_help

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

if [ "`whoami`" != "root" ]; then
	[ -z "`which pkexec`" ] && echo "pkexec is not installed"
	[ -z "`which sudo`" ] && echo "sudo is not installed"
	echo "This script should be run as root"
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

if [ ! -f /var/cache/apt/pkgcache.bin ]; then
echo -e "\e[32mapt update\e[0m"
apt-get update
[ $? -ne 0 ] && apt-get update # try again if failed
echo ''
fi

echo -e "apt install\e[33m $INSTALL\e[0m"
APT_ERRMSG="`apt-get -s -y --allow-downgrades install $INSTALL`"
ret=$?
if [ $ret -ne 0 ]; then
	echo "$APT_ERRMSG"
	echo -e "\n\e[0;31mSorry, there are one or more errors, see above\nCould be a typo in a package name. Exit.\e[0m"
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit $ret
fi

apt_install () {
echo -e "\e[32m\nInstallation starting . . .\e[0m"
DEBIAN_FRONTEND=noninteractive apt -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" --allow-downgrades --reinstall install $INSTALL && return 0
# try again if failed
if [ $? -ne 0 ]; then
DEBIAN_FRONTEND=noninteractive apt -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" --allow-downgrades --reinstall install $INSTALL && return 0
fi
touch /exit_
}
export -f apt_install

# Fix for 'mount -t overlay' with util-linux >=2.39
export LIBMOUNT_FORCE_MOUNT2=always

unmount_union() {
umount -l "$UNION"/proc 2> /dev/null
umount -l "$UNION"/dev/pts 2> /dev/null
umount -l "$UNION"/dev 2> /dev/null
umount -l "$UNION"/sys 2> /dev/null
umount -l "$UNION" 2> /dev/null
rmdir "$UNION" 2> /dev/null
[ "$?" -eq 0 ] && echo -e "\e[0;32mchroot directories succesfully unmounted\e[0m"
}
export -f unmount_union

# Function to cleanly unmount if the script is interrupted
exitfn() {
trap SIGINT # Resore signal handling for SIGINT
echo -e "\e[0;31mScript was interrupted, or there were errors\e[0m"

[ "$UNIONCREATED" ] && unmount_union
# Remove working directory
if [ -d "$WRITE" ]; then
	rm -rf "$WRITE"-w
	rm -f "$WRITE"/exit_
	[ "$RMDIR" ] && rm -rf "$WRITE"
fi

echo -en "\nExit. "
[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ." || echo ''
exit 1
}
export -f exitfn

MODNAME="`echo "$1" | cut -d= -f1 | tr -d ' '`"
MODNAME="`basename "$MODNAME"`"

export WRITE="$WORK"/"$MODNAME"

[ "$RMDIR" ] && rm -rf "$WRITE"

if [ -d "$WRITE" ]; then
	echo -e "Directory\e[1;33m ${WRITE} \e[0malready exists,\nPlease rename and run again."
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

if [ "$WORK" = "/mnt/live" ]; then SQFS='/tmp/'"$MODNAME".squashfs
else SQFS="$WORK/$MODNAME".squashfs
fi

if [ -f "$SQFS" ]; then
	echo -e "Module\e[1;33m ${SQFS} \e[0malready exists,\nPlease rename and run again."
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

if [ ! -x /mnt/live/memory/images/01-filesystem.squashfs/bin/bash ]; then
	echo "/mnt/live/memory/images/01-filesystem.squashfs/"
	echo "Directory is empty, something went wrong. Exit."
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

# Setup temp directories for mounting
rm -rf "$WRITE"-w
export UNION=/tmp/apt2sfs_chroot_$$
mkdir -p "$UNION" "$WRITE" "$WRITE"-w

LOWLIST="/mnt/live/memory/images/01-filesystem.squashfs"

echo -e "\e[0;32mMount the directories, prepare the chroot\e[0m"
# Mount the directories, prepare the chroot
mount -t overlay -o lowerdir=$LOWLIST,upperdir=$WRITE,workdir=$WRITE-w overlay "$UNION" 2> /dev/null
if [ $? -eq 0 ]; then 
	export UNIONCREATED=yes
else
	echo -e "\e[0;31mSorry, something went wrong. Exit.\e[0m"
	rmdir "$UNION" "$WRITE" "$WRITE"-w 2> /dev/null
	[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ."
	exit 1
fi

# Set up SIGINT trap to call function 'exitfn'
trap "exitfn" 1 2 15

# Do the required mount binds for chroot
mount --bind /proc "$UNION"/proc
mount --bind /dev "$UNION"/dev
mount --bind /sys "$UNION"/sys
mount -t devpts devpts "$UNION"/dev/pts

# Copy /etc/resolv.conf to provide network connection
[ -e "$UNION/etc/resolv.conf" ] && rm -f "$UNION"/etc/resolv.conf
cat /etc/resolv.conf > "$UNION"/etc/resolv.conf

# Copy apt/*pkgcache.bin and apt/lists/* files
cp -a /var/cache/apt/*pkgcache.bin "$UNION"/var/cache/apt/
find /var/lib/apt/lists -type f ! -name lock -exec cp {} "$UNION"/var/lib/apt/lists/ \;

# Copy status and available files
#cp -a /var/lib/dpkg/{available,status} "$UNION"/var/lib/dpkg/

# chroot and exec apt_install
chroot "$UNION" /bin/bash -c apt_install

# do not continue if there were errors
[ -f "$UNION/exit_" ] && exitfn

# Unmount overlayfs and rmdir /tmp/unionsfs-
unmount_union

echo -e "\nCleaning..."

# Remove overlayfs workdir
rm -rf "$WRITE"-w

if [ "$NOPKG" ]; then
	mv -f "$WRITE"/var/lib/dpkg/info "$WRITE"/var/lib/dpkg/infonew 2> /dev/null
	mv -f "$WRITE"/var/lib/dpkg/status "$WRITE"/var/lib/dpkg/statusnew 2> /dev/null
	mv -f "$WRITE"/var/lib/dpkg/available "$WRITE"/var/lib/dpkg/availablenew 2> /dev/null
fi

. /usr/local/lib/cleanup

cd "$WRITE" && cleanup 2> /dev/null
cd ..

if [ "$GUI" ]; then
	echo -e "\n\e[36mNow you may want to review files in:\e[1;33m ${WRITE}"
	echo -e "\e[0;36mAnd do some extra cleaning before creating module\e[0m\n"
fi

if [ "$PAUSE" ]; then
	read -s -n 1 -p "Press any key to run mksquashfs"
	echo ''
fi

grep -sq ^MKSFSCMP= /root/*.conf && \
MKSFSCMP=`grep ^MKSFSCMP= /root/*.conf | head -1 | cut -d= -f2 | sed s/\"//g`

mksquashfs "$WRITE" "$SQFS" -b 1M $MKSFSCMP
ret=$?

[ "$RMDIR" ] && rm -rf "$WRITE"

if [ $ret -eq 0 ]; then
	echo -e "\n\e[1mModule created:\e[33m ${SQFS}\e[0m"
else
	echo -en "\nFAILED. "
fi

[ "$GUI" ] && read -s -n 1 -p "Press any key to close . . ." || echo ''

exit $ret
