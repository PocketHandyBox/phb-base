#!/bin/sh

# redeb: script extract or build deb pkg's from filemanager
# by gumanzoy https://github.com/PocketHandyBox

notify_send() {
notify-send --app-name=redeb --replace-id=$$ "$@"
}

if [ -f "$1" ]; then
    FILE="`basename "$1"`"
    DIR="${1%.*}"
    [ -d "$DIR" ] && DIR="$DIR-$$"
    ERROR="`dpkg-deb --raw-extract "$1" "$DIR" 2>&1`"
    ret=$?
    if [ $ret -eq 0 ]; then
        notify_send --icon=deb "$FILE extracted" "$DIR"
    else
        notify_send -t 15000 --icon=dialog-error "Extract deb package Error" "$ERROR"
    fi
    exit $ret
fi

if [ -d "$1" ] && [ -f "$1".deb ]; then
yad --title="Build deb" --window-icon=deb --image=dialog-warning --center --fixed \
 --text="DEB file already exists, overwrite it?\n<tt>$1.deb</tt>"
[ $? -ne 0 ] && exit 1
fi

if [ -d "$1" ]; then
    notify_send --icon=deb "Building deb package . . ." "$1"
    ERROR="`dpkg-deb --root-owner-group --build "$1" 2>&1`"
    ret=$?
    if [ $ret -eq 0 ]; then
        notify_send --icon=deb "Build deb package... Done" "$1.deb"
    else
        notify_send -t 15000 --icon=dialog-error "Build deb package Error" "$ERROR"
    fi
    exit $ret
fi

echo "Usage:"
echo "Extract deb: redeb <package>.deb"
echo "Build deb: redeb <packagedirectory>"
exit 0
